{
  "mcpServers": {
    "lead-decisions": {
      "type": "stdio",
      "command": "unsloth_env/bin/python",
      "args": ["integration/decision_server.py", "--model", "outputs/lead-decision-merged"]
    },
    "reply-decisions": {
      "type": "stdio",
      "command": "unsloth_env/bin/python",
      "args": ["integration/decision_server.py", "--model", "outputs/reply-decision-merged"]
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
    }
  }
}
